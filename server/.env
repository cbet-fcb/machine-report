# Enable server request test suite
# If this is set true, all "hungarian notated" features are parsed and read
# [TEST_SUITE_*]=[True | False]
TEST_SUITE_REPORT_ACTIONS=False

# Take the first letters of the TEST_SUITE_*
# Append it to the feature variable
# Implement it using 
# -+-+-+-+-+-+-+-+-+-+-+-+
# import os
# from dotenv import load_dotenv 
# load_dotenv()
# -+-+-+-+-+-+-+-+-+-+-+-+
# OR
# -+-+-+-+-+-+-+-+-+-+-+-+
# import os
# import dotenv 
# dotenv.load_dotenv()
# -+-+-+-+-+-+-+-+-+-+-+-+  
# https://en.wikipedia.org/wiki/Hungarian_notation
TSRA_ENABLE_FEEDBACK=False
TSRA_DISABLE_CHECKING_OF_KEYS=False
TSRA_DELETE_ALL_DATA=False
TSRA_DISABLE_SCHEDULER=False